# Copy to .env and fill in only what you need. The default configuration is fully local
# and needs none of these values.

# Optional: use an OpenAI-compatible endpoint for generation or the LLM judge.
# Set generation.provider / evaluation.judge.provider to "openai_compatible" in YAML.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: LangSmith tracing. Also set tracing.enabled: true in configs/config.yaml.
# With no key present, tracing stays off and runs continue normally.
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=rag-bench

# Optional: higher rate limits when downloading Hugging Face models.
# HF_TOKEN=
